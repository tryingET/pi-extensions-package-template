{
  "version": 1,
  "required_files": [
    ".copier-answers.yml",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CHANGELOG.md",
    "biome.jsonc",
    ".vscode/settings.json",
    "package.json",
    "extensions/{{command_name}}.ts",
    "docs/org/operating_model.md",
    "docs/project/foundation.md",
    "docs/project/vision.md",
    "docs/project/incentives.md",
    "docs/project/resources.md",
    "docs/project/contributing.md",
    "docs/project/extension-sop.md",
    "docs/project/trusted-publishing.md",
    "docs/tech-stack.local.md",
    "docs/adr/.gitkeep",
    "policy/stack-lane.json",
    "policy/security-policy.json",
    "scripts/release-check.sh",
    "scripts/validate-structure.sh",
    "scripts/validate-structure.mjs",
    "scripts/quality-gate.sh",
    "scripts/docs-list.sh",
    ".pi/prompts/commit.md"
  ],
  "forbidden_paths": [
    "copier-template",
    "copier.yml",
    "new-pi-extension-repo.sh",
    ".github",
    ".githooks",
    "scripts/install-hooks.sh"
  ],
  "forbidden_globs": [
    "**/*.jinja"
  ],
  "forbidden_content_patterns": [
    "(?<!\\$)\\{\\{\\s*[^{}\\n]+\\s*\\}\\}",
    "\\{username\\}",
    "\\{repo\\}",
    "\\{discordInvite\\}",
    "\\{@twitter\\}",
    "<repo-name>",
    "<command-name>",
    "@your-github-handle"
  ],
  "content_scan_exclude_paths": [
    "scripts/validate-structure.sh"
  ]
}
